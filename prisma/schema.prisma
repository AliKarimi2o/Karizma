// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  lang         String   @default("en") // "en" or "fa"
  darkMode     Boolean  @default(true)
  skills       String   @default("[]") // JSON string of skills as tags
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  tasksCreated Task[]          @relation("TaskCreator")
  tasksAssigned Task[]         @relation("TaskAssignee")
  comments     Comment[]
  attachments  FileAttachment[]
  reminders    Reminder[]
  notifications Notification[]
  votes        PollVote[]
  announcements Announcement[] @relation("AnnouncementCreator")
  chatMessages ChatMessage[]
  conversations AIConversation[]
  activityLogs ActivityLog[]
  baleConnection BaleConnection?
}

model Workspace {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String?  @default("general")
  goal        String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       WorkspaceMember[]
  tasks         Task[]
  attachments   FileAttachment[]
  polls         Poll[]
  announcements Announcement[]
  chatMessages  ChatMessage[]
  conversations AIConversation[]
  activityLogs  ActivityLog[]
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        String   @default("member") // "owner", "admin", "manager", "member", "viewer"
  permissions String   @default("[]") // JSON serialized array of permission strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Task {
  id                   String    @id @default(uuid())
  workspaceId          String?
  creatorId            String
  assigneeId           String?
  title                String
  description          String?
  priority             String    @default("medium") // "low", "medium", "high", "critical"
  status               String    @default("todo") // "todo", "in_progress", "waiting", "done", "cancelled", "archived"
  deadline             DateTime?
  startDate            DateTime?
  estimatedDuration    Int?      // in minutes or hours as needed
  actualCompletionDate DateTime?
  progress             Int       @default(0) // 0 to 100
  tags                 String    @default("[]") // JSON array of strings
  isPersonal           Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  workspace   Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User             @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  subtasks    Subtask[]
  comments    Comment[]
  attachments FileAttachment[]
}

model Subtask {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FileAttachment {
  id          String   @id @default(uuid())
  taskId      String?
  workspaceId String?
  userId      String
  filename    String
  filepath    String
  filetype    String
  filesize    Int
  createdAt   DateTime @default(now())

  task      Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  dueTime     DateTime
  isCompleted Boolean  @default(false)
  isSentToBale Boolean @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // "info", "task", "reminder", "system"
  isRead    Boolean  @default(false)
  link      String?  // Frontend app path link
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Poll {
  id          String   @id @default(uuid())
  workspaceId String
  question    String
  isClosed    Boolean  @default(false)
  creatorId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  text   String

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]
}

model PollVote {
  id       String   @id @default(uuid())
  pollId   String
  optionId String
  userId   String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Announcement {
  id          String   @id @default(uuid())
  workspaceId String
  title       String
  content     String
  creatorId   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation("AnnouncementCreator", fields: [creatorId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  text        String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIConversation {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // "user" or "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String?
  userId      String
  action      String   // e.g., "CREATE_TASK", "DELETE_WORKSPACE", "MEMBER_REMOVED"
  details     String?  // Description or context
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BaleConnection {
  id               String   @id @default(uuid())
  userId           String   @unique
  baleChatId       String   @unique
  baleUsername     String?
  syncReminders    Boolean  @default(true)
  syncAssignments  Boolean  @default(true)
  syncAnnouncements Boolean @default(true)
  connectionCode   String?  // One-time code for verification in webapp
  isVerified      Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
